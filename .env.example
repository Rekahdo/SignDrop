# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional Resend API key for sending emails with attachments
RESEND_API_KEY=""

# SENDGRID_API_KEY: Optional SendGrid API key for sending emails
SENDGRID_API_KEY=""

# EMAIL_SENDER: From address for transactional emails (defaults to 'onboarding@resend.dev' or custom verified sender)
EMAIL_SENDER="Signatures <onboarding@resend.dev>"
